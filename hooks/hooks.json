{
  "modules": ["./register.ts"],
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|compact|clear|fork", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-start.js\"", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/stop-word.js\"", "timeout": 10 },
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/context-gauge.js\"", "timeout": 10 },
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/board-context.js\"", "timeout": 10 }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/stop-guard.js\"", "timeout": 10, "onFailure": "block" }] },
      { "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell|Monitor|WebFetch|ListMcpResourcesTool|ReadMcpResourceTool|mcp__.*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/tool-guard.js\"", "timeout": 10, "onFailure": "block" }] }
    ],
    "PostToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/prompt-record.js\"", "timeout": 10 }] }
    ],
    "SubagentStop": [
      { "matcher": "^wheelhouse:(builder|reviewer)$", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/report-check.js\"", "timeout": 10 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/precompact-guard.js\"", "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/stop-guard.js\"", "timeout": 10 }] }
    ]
  }
}
