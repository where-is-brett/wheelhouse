+/**
+ * Cancel a paused run. Nothing is running, so no owner need answer; one that does is stopped first. Its checkout stays,
+ * and `cancelled` releases its worktree lock and resource slot.
+ */
+async function cancelPaused(
+  ctx: OperationContext,
+  run: WorkflowRun
+): Promise<CancelWorkflowResult> {
+  const owner = await stopLiveOwner(ctx, run);
+  if (owner.kind === 'not_stopped') throw new CancelRefusedError('not_stopped', owner.message);
+  const warnings = owner.kind === 'stopped' ? owner.cleanupWarnings : undefined;
+  const { cancelled, ...recorded } = await recordAbandoned(ctx, run, warnings);
+  if (!warnings?.length) await releaseRunScratch(run);
+  return { kind: 'cooperative', cancelled, ...recorded };
+}
+
+/**
+ * Cancel a running run whose owner is proved gone: nothing answers at its endpoint, and the process recorded as its
+ * owner no longer exists on this host. Like a paused run, its checkout stays, and `cancelled` releases its worktree
+ * lock and resource slot. The steps that owner started aren't stopped: nothing here can name them.
+ */
+async function cancelLost(ctx: OperationContext, run: WorkflowRun): Promise<CancelWorkflowResult> {
+  const { cancelled, ...recorded } = await recordAbandoned(ctx, run);
+  if (cancelled) await releaseRunScratch(run);
+  return { kind: 'cooperative', cancelled, ...recorded };
+}
