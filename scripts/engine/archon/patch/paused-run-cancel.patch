# scripts/engine/archon/patch/paused-run-cancel.patch
# Lets `workflow cancel` take a paused run, keeping its worktree. Unpatched, cancel refuses any run that isn't running
# and points at abandon, which removes the worktree with its uncommitted work, so Wheelhouse never calls it. So a run
# paused at an ask couldn't be stopped by a cancel, a cap or All stop (check 74). A run that isn't paused behaves as
# released. Applied with `git apply` to Archon v0.13.0 (commit 0d39c1f2); see docs/engine/archon-upstream-note.md.
diff --git a/packages/core/src/operations/workflow/cancel.ts b/packages/core/src/operations/workflow/cancel.ts
index 117d916..7ab561a 100644
--- a/packages/core/src/operations/workflow/cancel.ts
+++ b/packages/core/src/operations/workflow/cancel.ts
@@ -94,6 +94,8 @@ export async function cancelWorkflow(
 ): Promise<CancelWorkflowResult> {
   const run = await ctx.getRunOrThrow(runId, 'operations.workflow_cancel_lookup_failed');
   await ctx.assertMayAct(run, actor, 'cancel');
+  // Wheelhouse: a paused run cancels too, keeping its worktree: abandon would remove its uncommitted work.
+  if (run.status === 'paused') return cancelPaused(ctx, run);
   if (run.status !== 'running') {
     throw new CancelRefusedError(
       'not_running',
@@ -134,6 +136,22 @@ export async function cancelWorkflow(
   return { kind: 'stopped', pid: owner.pid, ...recorded };
 }
 
+/**
+ * Cancel a paused run. Nothing is running, so no owner need answer; one that does is stopped first. Its checkout stays,
+ * and `cancelled` releases its worktree lock and resource slot.
+ */
+async function cancelPaused(
+  ctx: OperationContext,
+  run: WorkflowRun
+): Promise<CancelWorkflowResult> {
+  const owner = await stopLiveOwner(ctx, run);
+  if (owner.kind === 'not_stopped') throw new CancelRefusedError('not_stopped', owner.message);
+  const warnings = owner.kind === 'stopped' ? owner.cleanupWarnings : undefined;
+  const { cancelled, ...recorded } = await recordAbandoned(ctx, run, warnings);
+  if (!warnings?.length) await releaseRunScratch(run);
+  return { kind: 'cooperative', cancelled, ...recorded };
+}
