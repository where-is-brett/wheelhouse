{
  "step": 5,
  "title": "Protected variables",
  "trials": [
    {
      "what": "the maintainer makes a protected, masked variable PROBE_SECRET",
      "result": "HTTP 201, protected=true, masked=true"
    },
    {
      "what": "the maintainer makes an unprotected variable PROBE_PLAIN",
      "result": "HTTP 201, protected=false"
    },
    {
      "what": "GET /projects/:id/variables as the maintainer (names and flags; the values are not kept)",
      "result": "[{\"key\":\"PROBE_SECRET\",\"protected\":true,\"masked\":true,\"environment_scope\":\"*\"},{\"key\":\"PROBE_PLAIN\",\"protected\":false,\"masked\":false,\"environment_scope\":\"*\"}]"
    },
    {
      "what": "GET /projects/:id/audit_events as the maintainer",
      "result": "HTTP 403, {\"message\":\"403 Forbidden\"}"
    },
    {
      "what": "GET /groups/:id/audit_events as the maintainer",
      "result": "HTTP 403, {\"message\":\"403 Forbidden\"}"
    },
    {
      "what": "the bot (a Developer) reads the variable through the API",
      "result": "HTTP 403"
    },
    {
      "what": "the merge request's pipeline",
      "result": "{\"state\":\"opened\",\"detailedMergeStatus\":\"mergeable\",\"headPipeline\":{\"status\":\"success\",\"source\":\"merge_request_event\"}}"
    },
    {
      "what": "the merge request's pipeline job (success) echoes",
      "result": "PROBE_SECRET is not set"
    },
    {
      "what": "the job log holds the variable's value",
      "result": "no"
    }
  ],
