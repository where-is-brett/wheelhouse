{
  "step": 3,
  "title": "The project key",
  "trials": [
    {
      "what": "the group setting resource_access_token_creation_allowed, as the group stands",
      "result": "true"
    },
    {
      "what": "makeProjectKey as the maintainer, setting on",
      "result": "created (a Developer-level key, one day, scopes api and write_repository)"
    },
    {
      "what": "who the key is",
      "result": "HTTP 200, a bot user named like project_<id>_bot_<suffix>, bot=true"
    },
    {
      "what": "PUT /groups/:id with resource_access_token_creation_allowed=false",
      "result": "HTTP 200; the group's JSON does not carry the field; the setting reads true afterwards"
    },
    {
      "what": "the setting switched off (written in the database, as the Permissions checkbox \"Allow group and project access tokens\" would write it)",
      "result": "false"
    },
    {
      "what": "makeProjectKey as the maintainer, setting off",
      "result": "refused with Wheelhouse's message: GitLab refused the request for a project key (HTTP 400)"
    },
    {
      "what": "POST /projects/:id/access_tokens as the maintainer, setting off",
      "result": "HTTP 400, body {\"message\":\"400 Bad request - User does not have permission to create project access token\"}"
    },
    {
      "what": "GET /projects/:id/access_tokens as the maintainer, setting off",
      "result": "HTTP 200"
    },
    {
      "what": "the key made before, used while the setting is off",
      "result": "HTTP 200"
    },
    {
      "what": "the setting switched back on",
      "result": "true"
    }
  ],
