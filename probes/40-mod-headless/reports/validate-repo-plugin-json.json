  },
  "contents": [
    {
      "file": "<repo>/CLAUDE.md",
      "type": "plugin",
      "errors": [],
      "warnings": [
        {
          "path": "root",
          "message": "CLAUDE.md at the plugin root is not loaded as project context. To ship context with your plugin, use a skill (skills/<name>/SKILL.md) instead.",
          "code": null
        }
      ],
      "notes": [],
      "gatingHooks": []
    },
    {
      "file": "<repo>/hooks/hooks.json",
      "type": "hooks",
      "errors": [],
      "warnings": [],
      "notes": [
        "./register.ts hooks: session.start, session.measure, prompt.submit, command.run{command=go}",
        "./register.ts answers its own command: command.run{command=go}",
        "./register.ts gating hook with .catch: prompt.submit",
        "./register.ts calls: $.command.register, $.process.run (via ask), $.session.id (via sendUsage), $.session.root, $.session.usage, $.ui.toast"
      ],
      "gatingHooks": [
        {
          "module": "./register.ts",
          "pattern": "prompt.submit",
          "hook": "prompt.submit",
          "hasCatch": true
        }
      ]
    }
  ],
  "advice": [
    {
      "file": "<repo>/README.md",
      "message": "This README has no line that installs \"wheelhouse\" from a marketplace. Add the install line, which works in one step on Claude Code 2.1.275 or later. Validate the folder that holds its marketplace.json to have <owner>/<repo> filled in, and the name its marketplace lists it under.",
      "installLine": "/plugin install wheelhouse --marketplace <owner>/<repo>"
    }
  ]
}
