{
  "name": "wheelhouse",
  "description": "Lets a director who is not a developer run AI agents that build their product.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/where-is-brett/wheelhouse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/where-is-brett/wheelhouse.git"
  },
  "bugs": {
    "url": "https://github.com/where-is-brett/wheelhouse/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --import ./tests/helpers/test-home.js --test-timeout=480000 \"tests/**/*.test.js\"",
    "copilot-home": "node scripts/agents/copilot/home.js --write",
    "mod-check": "node scripts/mod/validate.js && claude plugin test .",
    "eval": "node scripts/eval/run.js",
    "private-check": "node scripts/install/private-words.js"
  }
}
